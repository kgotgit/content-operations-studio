# drupal-consumer (PHP 8.x): environment variables
# On Vercel, set these in Project → Settings → Environment Variables.

# Origin of the deployed content-presentation Next.js app (no trailing slash).
REMOTE_ORIGIN=https://content-presentation.vercel.app

# Required only if REMOTE_ORIGIN has Vercel Deployment Protection enabled (e.g. Preview URLs).
# Server-side only; never exposed to HTML or browser JS.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Optional defaults for `/`
DEFAULT_CHANNEL=web
DEFAULT_EXPERIENCE=general
DEFAULT_LOCALE=en-US

# Optional robots override (defaults to "index, follow" on Vercel production, "noindex" otherwise)
ROBOTS_DIRECTIVE=
