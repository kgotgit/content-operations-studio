# dotnet-consumer (ASP.NET Core 8): environment variables

# Origin of the deployed content-presentation Next.js app (no trailing slash).
REMOTE_ORIGIN=https://content-presentation.vercel.app

# Required only if REMOTE_ORIGIN has Vercel Deployment Protection enabled (e.g. Preview URLs).
# Server-side only; never exposed to HTML or browser JS.
VERCEL_AUTOMATION_BYPASS_SECRET=

# In-memory cache TTL in seconds (0 disables caching).
CACHE_TTL_SECONDS=300

# Optional robots override (defaults to "index, follow" in Production, "noindex" otherwise).
ROBOTS_DIRECTIVE=
