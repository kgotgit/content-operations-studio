# content-presentation: environment variables
# Copy to `.env.local` for local development. On Vercel, set these in
# Project → Settings → Environment Variables (Production / Preview / Development).
# Values starting with NEXT_PUBLIC_ are inlined at build time; changing them needs a redeploy.

# ── Sanity (read-only content fetch) ───────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=he21d3pg
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Server-only Viewer token. Required only if the dataset is private. Never prefix with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# ── Webhook revalidation (/api/revalidate) ─────────────────────────────────────
# Required on Vercel (the route returns 500 without it). Generate: openssl rand -hex 32
# Configure the same value in the Sanity / Smartling webhook (Authorization: Bearer <secret>).
REVALIDATION_SECRET=

# ── Public URLs ────────────────────────────────────────────────────────────────
# Canonical origin of this app. Optional on Vercel: falls back to VERCEL_PROJECT_PRODUCTION_URL
# (production) or VERCEL_URL (previews).
NEXT_PUBLIC_SITE_URL=
# Experience domains used to absolutize navigation links inside the remote component (Drupal).
NEXT_PUBLIC_GENERAL_DOMAIN=https://www.company.com
NEXT_PUBLIC_RETIREMENT_DOMAIN=https://workplace.company.com
NEXT_PUBLIC_ADVISOR_DOMAIN=https://advisorservices.company.com

# ── Remote component delivery (Drupal / non-Next consumers) ────────────────────
# Origin allowed to load /remote/*, /remote-host/* and /_next/static/* cross-origin.
# "*" (default) or a single origin, e.g. https://www.company.com
REMOTE_CORS_ALLOW_ORIGIN=*

# Vercel Deployment Protection → "Protection Bypass for Automation" secret.
# Sent as `x-vercel-protection-bypass` on server-to-server payload fetches
# (drupal-preview route, generate-remote-payload-pages.mjs, Drupal PHP) and read by the
# remote-components library itself. Vercel injects it automatically once enabled.
VERCEL_AUTOMATION_BYPASS_SECRET=

# ── Payload pages (drupal-preview route + generate-remote-payload-pages.mjs) ───
# Where payloads are fetched from server-side. Default: this deployment (keeps the payload's
# chunk hashes in sync with the assets this deployment serves).
REMOTE_ORIGIN=
# Origin written into <remote-component src> / <template data-src>. Default: REMOTE_ORIGIN.
REMOTE_PUBLIC_ORIGIN=
# Origin that serves /remote-host/<bundle>.js. Empty = same origin as the page. Set to the
# remote app's URL when the page is hosted elsewhere (real Drupal).
REMOTE_ASSET_ORIGIN=
# Comma-separated flavours, default: web/general/en-US,web/general/zh-Hant,web/general/es,web/retirement/en-US
REMOTE_FLAVOURS=
# Robots directive for /drupal-preview and /drupal-pages pages.
# Default: "index, follow" on production, "noindex" on preview/development.
DRUPAL_PREVIEW_ROBOTS=
