# content-studio (Sanity Studio): environment variables
# Copy to `.env` for local development. On Vercel, set these in
# Project → Settings → Environment Variables. Only SANITY_STUDIO_* variables are exposed
# to the Studio bundle, and they're inlined at build time (redeploy after changes).
# Never put write tokens here: anything SANITY_STUDIO_* ends up in public JavaScript.

SANITY_STUDIO_PROJECT_ID=he21d3pg
SANITY_STUDIO_DATASET=production
# Dataset used by `sanity` CLI commands (deploy-graphql, dataset import). Defaults to SANITY_STUDIO_DATASET.
SANITY_STUDIO_CLI_DATASET=production

# Workflow engine settings
SANITY_STUDIO_WORKFLOW_TAG=prod
SANITY_STUDIO_WORKFLOW_DEV_DATASET=dev
SANITY_STUDIO_WORKFLOW_PROD_DATASET=production
